{
  "name": "jamroom",
  "version": "1.0.0",
  "private": true,
  "description": "Listen together inside Spotify (Spicetify extension) with songs from Spotify, YouTube, SoundCloud, links and files; also a standalone web app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okabeeer/JamRoom.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "build:plugin": "vite build --config plugin/vite.config.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "music-metadata": "^12.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "three": "^0.186.1",
    "trystero": "^0.25.4",
    "vite": "^8.3.4"
  }
}
